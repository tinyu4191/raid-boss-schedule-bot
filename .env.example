DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# DISCORD_TOKEN=機器人的登入密碼               | Developer Portal → 你的 App → Bot 頁籤 → Token → Reset/Copy
# CLIENT_ID=App 本身的 ID（不是 Bot Token）    | 同一個 App → General Information 頁籤 → 最上面 APPLICATION ID
# GUILD_ID=你的 Discord 伺服器的 ID（不是頻道） | Discord 設定 → 進階 → 開啟「開發者模式」→ 在伺服器名稱按右鍵 → 複製伺服器 ID

# ============================================================
# 王設定：每個王固定 4 行，編號從 1 開始「連續」填寫
# （中間不能空號，程式讀到第一個沒填的編號就停止）
#
# 之後要加新王：接著往下加下一個編號的區塊 → 存檔 → 重啟 bot 就生效
# 不用改程式、不用跑指令
# ============================================================

BOSS_1_NAME=樹王
BOSS_1_SIGNUP_CHANNEL_ID=
BOSS_1_SCHEDULE_CHANNEL_ID=
BOSS_1_EMOJI=🌳
BOSS_1_COLOR=#57F287

# 之後加龍王，取消下面註解並填上頻道 ID 即可：
# BOSS_2_NAME=龍王
# BOSS_2_GUILD_ID=（第二個語音群的伺服器 ID）
# BOSS_2_SIGNUP_CHANNEL_ID=
# BOSS_2_SCHEDULE_CHANNEL_ID=
# BOSS_2_EMOJI=🐉
# BOSS_2_COLOR=#ED4245

# BOSS_3_NAME=蝴蝶王
# BOSS_3_GUILD_ID=（第二個語音群的伺服器 ID）
# BOSS_3_SIGNUP_CHANNEL_ID=
# BOSS_3_SCHEDULE_CHANNEL_ID=
# BOSS_3_EMOJI=🦋
# BOSS_3_COLOR=#EB459E

# EMOJI / COLOR 可省略，省略時分別預設 ⚔️ 與 #57F287
