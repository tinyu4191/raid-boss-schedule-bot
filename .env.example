# ============================================================
# Discord App 基本設定
# ============================================================

# 機器人的登入密碼
# Developer Portal → 你的 App → Bot 頁籤 → Token → Reset/Copy
DISCORD_TOKEN=

# App 本身的 ID（不是 Bot Token）
# 同一個 App → General Information 頁籤 → 最上面 APPLICATION ID
CLIENT_ID=

# 「預設」伺服器 ID —— 下面沒填 BOSS_n_GUILD_ID 的王都算在這裡
# 取得方式：Discord 設定 → 進階 → 開啟「開發者模式」→ 在伺服器名稱按右鍵 → 複製伺服器 ID
GUILD_ID=


# ============================================================
# 王的預設樣式（EMOJI / COLOR）
# ------------------------------------------------------------
# 同一種王不管出現在哪個語音群，長相通常都一樣，只要在這裡定義一次。
# 下面 BOSS_n 只要 NAME 跟這裡的 NAME 完全一致，就會自動套用對應的
# EMOJI / COLOR，不用每個語音群都重複填一次。
#
# ⚠️ COLOR 是色碼（開頭是 #），一定要加雙引號包起來！
#    不加引號的話，dotenv 會把 # 後面的內容當成註解整個吃掉，
#    最後顏色會安靜地變回預設值，不會報錯，但顏色是錯的。
#
# 新增一種王的樣式：往下接著加一組 STYLE_n_*，編號規則跟 BOSS_n 一樣，
# 從 1 開始連續填寫。STYLE 的編號跟 BOSS 的編號互相獨立，不用對齊。
#
# 如果某個 BOSS_n 想要跟這裡的樣式不一樣，可以在該 BOSS_n 自己填
# BOSS_n_EMOJI / BOSS_n_COLOR 覆蓋，優先度：
#   BOSS_n 自己填的 > 這裡對應名字的樣式 > 都沒有就用系統預設 (⚔️ / #57F287)
#
# 「已滿」「缺人」那兩個狀態用的 emoji（預設 🈵 / 🆓）也可以在這裡統一
# 設定，欄位是 FULL_EMOJI / MISSING_EMOJI，優先度規則完全一樣：
#   BOSS_n 自己填的 > 這裡對應名字的樣式 > 都沒有就用系統預設 (🈵 / 🆓)
# ============================================================

STYLE_1_NAME=樹王
STYLE_1_EMOJI=🌳
STYLE_1_COLOR="#57F287"
# STYLE_1_FULL_EMOJI=🈵       <- 不寫就用系統預設，這裡示範可以覆蓋
# STYLE_1_MISSING_EMOJI=🆓

STYLE_2_NAME=龍王
STYLE_2_EMOJI=🐉
STYLE_2_COLOR="#ED4245"

# ⚠️ 下面是還沒用到的樣式範例，想用哪個就解除該行的註解即可（不再要求
# 連續編號，直接解開你要的那幾行就好，其他保持註解也沒關係）。

# STYLE_3_NAME=蝴蝶王
# STYLE_3_EMOJI=🦋
# STYLE_3_COLOR="#EB459E"

# STYLE_4_NAME=拉圖斯(普通)
# STYLE_4_EMOJI=⚔️
# STYLE_4_COLOR="#57F287"

# STYLE_5_NAME=拉圖斯(困難)
# STYLE_5_EMOJI=🔥
# STYLE_5_COLOR="#ED4245"


# ============================================================
# 王設定：每個王固定幾行。編號不用連續、也不用從特定數字開始——
# 程式會自動掃描所有實際存在的 BOSS_n_NAME，不管數字之間有沒有跳號。
#
# 下面用顏色方塊 🟦🟩🟧 分隔不同語音群純粹方便閱讀，跟程式解析無關；
# 旁邊註記的「BOSS 編號」也只是給人看的參考，不影響運作。
#
# 之後要加新王：找一個還沒用過的編號（通常是接續目前最大的往下一號，
# 但不是必要）→ 加上對應的 BOSS_n_* 區塊 → 存檔 → 重啟 bot 就生效
# ============================================================

# ============================================================
# 🟦🟦🟦 語音群：ESC 🟦🟦🟦  （BOSS 編號 1 ~ 2）
# ============================================================

BOSS_1_NAME=樹王
BOSS_1_SIGNUP_CHANNEL_ID=
BOSS_1_SCHEDULE_CHANNEL_ID=

BOSS_2_NAME=龍王
BOSS_2_SIGNUP_CHANNEL_ID=
BOSS_2_SCHEDULE_CHANNEL_ID=
# BOSS_2_GUILD_ID=            <- 如果龍王其實在別的語音群，這裡填該群的伺服器 ID


# ============================================================
# 🟩🟩🟩 語音群：HoneyBun 🟩🟩🟩  （BOSS 編號 3 ~ 6）
# ============================================================

BOSS_3_NAME=樹王
BOSS_3_GUILD_ID=
BOSS_3_SIGNUP_CHANNEL_ID=
BOSS_3_SCHEDULE_CHANNEL_ID=

BOSS_4_NAME=龍王
BOSS_4_GUILD_ID=
BOSS_4_SIGNUP_CHANNEL_ID=
BOSS_4_SCHEDULE_CHANNEL_ID=

BOSS_5_NAME=拉圖斯(普通)
BOSS_5_GUILD_ID=
BOSS_5_SIGNUP_CHANNEL_ID=
BOSS_5_SCHEDULE_CHANNEL_ID=

BOSS_6_NAME=拉圖斯(困難)
BOSS_6_GUILD_ID=
BOSS_6_SIGNUP_CHANNEL_ID=
BOSS_6_SCHEDULE_CHANNEL_ID=


# ============================================================
# 🟧🟧🟧 語音群：<第三個語音群的名字> 🟧🟧🟧  （BOSS 編號 7 ~ ?）
# 複製上面任一區塊的格式往下接，記得改 GUILD_ID 跟頻道 ID
# ============================================================

# BOSS_7_NAME=
# BOSS_7_GUILD_ID=
# BOSS_7_SIGNUP_CHANNEL_ID=
# BOSS_7_SCHEDULE_CHANNEL_ID=


# ============================================================
# 共用一個報名頻道、多個王用 Discord Forum 標籤區分的做法（進階）
# ------------------------------------------------------------
# 有些語音群報名區不是一個王一個頻道，而是全部團都發在同一個報名
# Forum，靠 Forum 本身的「標籤」功能分王。加上 TAGS 這個欄位，這組
# 設定就會自動切換成「共用」模式：
# - NAME 這時候只是給你自己管理識別用，不會出現在行程表上
# - 行程表會把所有王混在一起、依時間排序，每則出團自動標上【王名】
# - TAGS 只列「王」的標籤名稱，時段/場次那些標籤不用列，bot 不會理會
# ============================================================

# BOSS_8_NAME=ESC混合突襲池
# BOSS_8_SIGNUP_CHANNEL_ID=
# BOSS_8_SCHEDULE_CHANNEL_ID=
# BOSS_8_TAGS=普拉,困拉,龍王
# ============================================================

# ============================================================
# 出團提醒改發到獨立頻道（進階，選填）
# ------------------------------------------------------------
# 出團提醒預設發在跟行程表 embed 同一個頻道（SCHEDULE_CHANNEL_ID）。
# 如果好幾個 Forum 都共用同一個行程表頻道（例如把好幾隻獨立的王都指
# 到同一個頻道，各自維護自己的 embed），這個頻道容易被「即時、看過
# 就沒用」的提醒訊息洗版，蓋掉原本安靜躺著、持續被編輯更新的行程表。
# 加上 REMINDER_CHANNEL_ID，這個王的提醒就會改發到別的頻道，
# SCHEDULE_CHANNEL_ID 那邊只留行程表 embed。不填就跟以前一樣，發在
# 行程表頻道。
#
# BOSS_9_NAME=闇黑龍王
# BOSS_9_SIGNUP_CHANNEL_ID=
# BOSS_9_SCHEDULE_CHANNEL_ID=
# BOSS_9_REMINDER_CHANNEL_ID=<另外開的提醒頻道ID>
# ============================================================
